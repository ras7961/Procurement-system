{
  "name": "procurement-system",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Assisted Broker-Centric Procurement Evaluation and Contract Administration System for Public Organizations",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "vitest run tests/architecture",
    "seed:roles": "vite-node --config vitest.config.ts scripts/seed-roles.ts",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "jose": "^6.2.17",
    "mongodb": "^7.8.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "mongodb-memory-server": "^10.4.3",
    "typescript": "^5.9.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
